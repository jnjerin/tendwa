# Copy this file to .env and fill in real values. Never commit .env itself.

# CockroachDB — from the Cloud Console "Connect" tab for your cluster
DATABASE_URL=

# CockroachDB — separate tendwa_test database on the same cluster, used by integration tests
# and `migrate --test`. Never point this at the same database as DATABASE_URL.
TEST_DATABASE_URL=

# Logging — pino level (trace|debug|info|warn|error|fatal). Safe to default; not a secret.
LOG_LEVEL=info

# Anthropic API — used by the engine's agent loop and reflection job for reasoning
ANTHROPIC_API_KEY=

# Embedding provider — Voyage AI (voyage-3.5, default 1024 dimensions, matches the
# VECTOR(1024) columns in the schema)
VOYAGE_API_KEY=

# Local API server port
PORT=3000

# AWS — needed once the reflection job is wired to Lambda; leave blank until then
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
