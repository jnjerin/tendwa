# Copy this file to .env.local and fill in real values. Never commit .env.local itself.
# Next.js loads .env.local from this app's own directory — not the repo root .env
# packages/engine/domains/incident-response use, since apps/web has no dependency on the engine.

# Base URL of apps/api (Fastify), no trailing slash — e.g. http://localhost:3000
TENDWA_API_BASE_URL=

# The org id every request is scoped to (see CLAUDE.md rule 5). Get this from the seeded demo
# org — domains/incident-response's seed script prints it, or query `SELECT id FROM orgs`.
TENDWA_ORG_ID=
