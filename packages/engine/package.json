{
  "name": "@tendwa/engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:test": "tsx src/db/migrate.ts --test",
    "reflect": "tsx src/memory/reflect.ts",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:integration": "vitest run integration.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "dotenv": "^16.4.7",
    "pg": "^8.13.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
